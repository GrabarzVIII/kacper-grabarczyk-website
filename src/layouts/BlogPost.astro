---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, date, updatedDate, cover } = Astro.props;
---

<html lang="pl">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				{cover && (
					<div class="hero-image">
						<Image width={1020} height={510} src={cover} alt={title} />
					</div>
				)}
				<div class="article-content">
					<div class="meta">
						<FormattedDate date={date} />
						{updatedDate && <span>· zaktualizowano <FormattedDate date={updatedDate} /></span>}
					</div>
					<h1>{title}</h1>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: min(var(--content-max), calc(100% - 1.5rem));
		margin: 0 auto;
		padding-top: 2rem;
	}
	.hero-image {
		max-width: 980px;
		margin: 0 auto 1.5rem auto;
	}
	.article-content {
		max-width: 760px;
		margin: 0 auto;
		padding-bottom: 4rem;
	}
	.meta {
		color: var(--color-muted);
		margin-bottom: 1rem;
	}
	h1 {
		margin-bottom: 1.5rem;
	}
</style>

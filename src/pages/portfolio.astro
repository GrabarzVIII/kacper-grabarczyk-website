---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import PageLayout from '../layouts/PageLayout.astro';

const projects = (await getCollection('projects')).filter((project) => !project.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title="Portfolio | Kacper Grabarczyk" description="Portfolio projektów Kacpera Grabarczyka — data analysis, SQL, Python, BI i engineering." pageName="Portfolio">
	<section class="section">
		<div class="container">
			<div class="section-heading">
				<div>
					<p class="section-kicker">Portfolio</p>
					<h1>Projekty i case studies</h1>
				</div>
			</div>
			<p class="intro-copy">To jest wersja MVP. Na tym etapie głównym celem jest pokazanie struktury i przygotowanie miejsca na prawdziwe case studies.</p>
			<div class="card-grid three-up">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>
</PageLayout>

<style>
	.intro-copy {
		max-width: 720px;
		margin-bottom: 2rem;
		color: var(--color-muted);
	}
	.card-grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	@media (max-width: 900px) {
		.card-grid {
			display: block;
		}
		.card-grid > :global(*) + :global(*) {
			margin-top: 1.5rem;
		}
	}
</style>

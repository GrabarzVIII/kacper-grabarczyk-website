---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import PageLayout from '../layouts/PageLayout.astro';

const projects = (await getCollection('projects')).filter((project) => !project.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title="Portfolio | Kacper Grabarczyk" description="Portfolio projektów Kacpera Grabarczyka — data analysis, SQL, Python, BI i engineering." pageName="Portfolio">
	<section class="section">
		<div class="container">
			<div class="section-heading">
				<div>
					<p class="section-kicker">Portfolio</p>
					<h1>Projekty prywatne</h1>
				</div>
			</div>
			<p class="intro-copy">Prywatne projekty, w których łączę automatyzację w n8n, modele językowe i pracę ze źródłami danych. Każdy opis wskazuje zrealizowany zakres. Repozytoria są prywatne, a projekty nie mają publicznego demo.</p>
			<div class="card-grid three-up">
				{projects.map((project) => <ProjectCard project={project} headingLevel="h2" />)}
			</div>
		</div>
	</section>
</PageLayout>

<style>
.intro-copy {
	max-width: 720px;
	margin-bottom: 2rem;
	color: var(--color-muted);
}
.card-grid {
	display: grid;
	gap: 1.5rem;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
}
.section-heading {
	margin-bottom: 2rem;
}
</style>

---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Tag from '../../components/Tag.astro';
import Button from '../../components/Button.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects', ({ data }) => !data.draft);
	return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, technologies, tags, cover, githubUrl, demoUrl } = project.data;
---

<PageLayout title={`${title} | Portfolio`} description={description}>
	<article class="project-page container">
		<header>
			<a class="back-link text-link" href="/portfolio">← Wszystkie projekty</a>
			<p class="section-kicker">Portfolio</p>
			<h1>{title}</h1>
			<p class="lead">{description}</p>
			<div class="tag-list" aria-label="Technologie">
				{technologies.map((technology) => <Tag label={technology} />)}
			</div>
			{(githubUrl || demoUrl) && <div class="project-actions">
				{githubUrl && <Button href={githubUrl} label="Kod na GitHubie" variant="secondary" external />}
				{demoUrl && <Button href={demoUrl} label="Otwórz demo" external />}
			</div>}
			{cover && <Image class="project-cover" src={cover} alt={title} width={1600} height={900} />}
		</header>
		<div class="prose project-content"><Content /></div>
		<footer class="project-footer">
			{tags.length > 0 && <div class="tag-list" aria-label="Tematy projektu">{tags.map((tag) => <Tag label={tag} />)}</div>}
			<a class="back-link text-link" href="/portfolio">← Wróć do portfolio</a>
		</footer>
	</article>
</PageLayout>

<style>
	.project-page {
		max-width: 920px;
		padding-block: 2rem;
	}
	.back-link {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		margin-bottom: 1rem;
	}
	.lead {
		font-size: clamp(1.1rem, 2vw, 1.4rem);
		color: var(--color-muted);
		max-width: 760px;
	}
	.project-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
	.project-cover {
		margin-top: 2rem;
	}
	.project-content {
		max-width: 760px;
		margin-block: 3rem;
		line-height: 1.75;
	}
	.project-footer {
		border-top: 1px solid var(--color-border);
		padding-top: 1.5rem;
	}
	.project-footer .tag-list {
		margin-bottom: 1rem;
	}
</style>

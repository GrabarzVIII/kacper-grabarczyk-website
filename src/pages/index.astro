---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PageLayout from '../layouts/PageLayout.astro';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const projects = (await getCollection('projects'))
	.filter((project) => !project.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
---

<PageLayout title="Data Specialist | Kacper Grabarczyk" description="Profil zawodowy, portfolio i blog techniczny Kacpra Grabarczyka — BI, integracje danych, SQL, Python i automatyzacja." pageName="Start">
	<Hero />

	<section class="section section-tint">
		<div class="container">
			<div class="split-intro">
				<div>
					<p class="section-kicker">Kim jestem</p>
					<h2>Pomagam firmom zamieniać dane w decyzje.</h2>
				</div>
				<p>
					Pracuję na styku Business Intelligence, integracji danych i automatyzacji. Łączę SQL, Python,
					ETL/ELT, API oraz narzędzia BI, aby porządkować dane, wspierać raportowanie i ułatwiać podejmowanie decyzji.
				</p>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading">
				<p class="section-kicker">Specjalizacja</p>
				<h2>Obszary, w których działam</h2>
			</div>
			<div class="pill-grid">
				<div class="card info-card"><h3>Business Intelligence</h3><p>Raporty, dashboardy i interpretacja danych wspierające decyzje biznesowe.</p></div>
				<div class="card info-card"><h3>ETL / ELT i API</h3><p>Integracje danych, procesy pobierania danych i automatyzacja przepływów.</p></div>
				<div class="card info-card"><h3>SQL i BigQuery</h3><p>Praca z relacyjnymi bazami danych, pipeline'ami oraz danymi analitycznymi.</p></div>
				<div class="card info-card"><h3>Python i pandas</h3><p>Analiza danych, transformacje oraz automatyzacja zadań analitycznych.</p></div>
				<div class="card info-card"><h3>Jakość danych i AI</h3><p>Walidacja danych, monitoring oraz rozwój workflow RAG, LLM i n8n.</p></div>
			</div>
		</div>
	</section>

	<section class="section section-tint">
		<div class="container">
			<div class="section-heading inline-heading">
				<div>
					<p class="section-kicker">Portfolio</p>
					<h2>Wybrane projekty</h2>
				</div>
				<Button href="/portfolio" label="Zobacz więcej" variant="secondary" />
			</div>
			<div class="card-grid three-up">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading inline-heading">
				<div>
					<p class="section-kicker">Blog</p>
					<h2>Najnowsze wpisy</h2>
				</div>
				<Button href="/blog" label="Przejdź do bloga" variant="secondary" />
			</div>
			<div class="card-grid three-up">
				{posts.map((post) => <ArticleCard post={post} />)}
			</div>
		</div>
	</section>

	<section class="section section-tint">
		<div class="container youtube-callout card">
			<div>
				<p class="section-kicker">DaneDaneTech</p>
				<h2>Technologia, dane i praktyka w jednym miejscu.</h2>
			</div>
			<p>
				Na kanale DaneDaneTech dzielę się materiałami o SQL, Pythonie, BI, modelowaniu danych i pracy
				z narzędziami analitycznymi. To miejsce dla osób, które chcą rozwijać swoje umiejętności w praktyce.
			</p>
			<Button href="https://www.youtube.com/@DaneDaneTech" label="Otwórz kanał" variant="secondary" external />
		</div>
	</section>

	<section class="section">
		<div class="container cta-row">
			<div class="card cta-box">
				<h3>Chcesz porozmawiać o danych?</h3>
				<p>Jeśli potrzebujesz wsparcia w SQL, analityce, BI lub pipeline'ach danych — napisz.</p>
				<Button href="/kontakt" label="Skontaktuj się" />
			</div>
			<div class="card cta-box">
				<h3>Chcesz zobaczyć więcej treści?</h3>
				<p>Sprawdź wpisy na blogu i poznaj moje podejście do pracy z danymi.</p>
				<Button href="/blog" label="Czytaj bloga" variant="secondary" />
			</div>
		</div>
	</section>
</PageLayout>

<style>
	.hero {
		padding-top: 2rem;
	}
	.hero-content {
		max-width: 900px;
	}
	.hero-copy {
		padding: 3rem 0;
	}
	.hero-name {
		margin: -1rem 0 2rem;
		font-size: clamp(1.25rem, 2vw, 1.8rem);
		font-weight: 600;
		color: var(--color-muted);
	}
	.split-intro {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 2rem;
		align-items: end;
	}
	.section-heading {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
		align-items: end;
	}
	.inline-heading {
		align-items: center;
	}
	.pill-grid,
	.card-grid {
		display: grid;
		gap: 1.5rem;
	}
	.pill-grid {
		grid-template-columns: repeat(5, minmax(0, 1fr));
	}
	.info-card {
		padding: 1.2rem;
	}
	.three-up {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.project-card,
	.article-card {
		overflow: hidden;
	}
	.project-cover img,
	.article-cover img {
		width: 100%;
		height: 220px;
		object-fit: cover;
		border-radius: 0;
	}
	.article-card-body,
	.project-body {
		padding: 1.2rem;
	}
	.project-links {
		display: flex;
		gap: 0.8rem;
		margin-top: 1rem;
	}
	.project-links a {
		font-weight: 700;
		color: var(--color-primary);
	}
	.youtube-callout {
		display: grid;
		grid-template-columns: 1.1fr 1fr auto;
		gap: 1rem;
		padding: 2rem;
		align-items: center;
	}
	.cta-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}
	.cta-box {
		padding: 1.6rem;
	}
	@media (max-width: 900px) {
		.split-intro,
		.youtube-callout,
		.three-up,
		.pill-grid,
		.cta-row {
			grid-template-columns: 1fr;
		}
		.section-heading,
		.inline-heading {
			display: block;
		}
		.hero-copy {
			padding: 2rem 0 1rem;
		}
	}
	@media (max-width: 520px) {
		.hero {
			padding-top: 0;
		}
		.hero-copy {
			padding-top: 1rem;
		}
	}
</style>

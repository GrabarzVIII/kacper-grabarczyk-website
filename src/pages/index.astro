---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PageLayout from '../layouts/PageLayout.astro';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const projects = (await getCollection('projects'))
	.filter((project) => !project.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const specializations = [
	{
		title: 'Business Intelligence',
		description: 'Dashboardy, raporty i interpretacja danych wspierające decyzje biznesowe.',
		icon: 'https://cdn.simpleicons.org/chartdotjs/5b2217',
	},
	{
		title: 'ETL / ELT i API',
		description: 'Integracje danych, procesy pobierania danych i automatyzacja przepływów.',
		icon: 'https://cdn.simpleicons.org/googlecloud/5b2217',
	},
	{
		title: 'SQL i BigQuery',
		description: 'Relacyjne bazy danych, pipeline’y oraz dane analityczne w BigQuery.',
		icon: 'https://cdn.simpleicons.org/googlebigquery/5b2217',
	},
	{
		title: 'Python i pandas',
		description: 'Analiza danych, transformacje i automatyzacja zadań analitycznych.',
		icon: 'https://cdn.simpleicons.org/python/5b2217',
	},
	{
		title: 'Automatyzacja i n8n',
		description: 'Automatyzacja procesów operacyjnych i analitycznych, integracje oraz workflow n8n.',
		icon: 'https://cdn.simpleicons.org/n8n/5b2217',
	},
];
---

<PageLayout title="Data Specialist | Kacper Grabarczyk" description="Profil zawodowy, portfolio i blog techniczny Kacpra Grabarczyka — BI, integracje danych, SQL, Python i automatyzacja.">
	<Hero />

	<section class="section section-tint">
		<a class="about-section-link" href="/about" aria-label="O mnie: poznaj moje doświadczenie i podejście do danych">
			<div class="container about-section-inner">
				<div class="split-intro">
					<div>
						<p class="section-kicker">Kim jestem</p>
						<h2>Dostarczam rozwiązania od surowych danych do decyzji biznesowych</h2>
					</div>
					<p>
						Pracuję na styku Business Intelligence, integracji danych i automatyzacji. Łączę SQL, Python,
						ETL/ELT, API oraz narzędzia BI, aby porządkować dane, wspierać raportowanie i ułatwiać podejmowanie decyzji.
					</p>
				</div>
				<span class="about-section-cue" aria-hidden="true">Poznaj mnie <span>→</span></span>
			</div>
		</a>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading specialization-heading">
				<p class="section-kicker">Specjalizacja</p>
				<h2>Obszary, w których działam</h2>
			</div>
			<div class="pill-grid">
				{specializations.map((specialization) => (
					<div class="card info-card">
						<img class="specialization-icon" src={specialization.icon} alt="" loading="lazy" />
						<h3>{specialization.title}</h3>
						<p>{specialization.description}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="section section-tint">
		<div class="container">
			<div class="section-heading inline-heading">
				<div>
					<p class="section-kicker">Portfolio</p>
					<h2>Wybrane projekty</h2>
				</div>
				<Button href="/portfolio" label="Zobacz więcej" variant="secondary" />
			</div>
			<div class="card-grid three-up">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading inline-heading">
				<div>
					<p class="section-kicker">Blog</p>
					<h2>Najnowsze wpisy</h2>
				</div>
				<Button href="/blog" label="Przejdź do bloga" variant="secondary" />
			</div>
			<div class="card-grid three-up">
				{posts.map((post) => <ArticleCard post={post} />)}
			</div>
		</div>
	</section>

	<section class="section section-tint">
		<div class="container youtube-callout card">
			<div>
				<p class="section-kicker">DaneDaneTech</p>
				<h2>Technologia, dane i praktyka w jednym miejscu.</h2>
			</div>
			<p>
				Na kanale DaneDaneTech dzielę się materiałami o SQL, Pythonie, BI, modelowaniu danych i pracy
				z narzędziami analitycznymi. To miejsce dla osób, które chcą rozwijać swoje umiejętności w praktyce.
			</p>
			<Button href="https://www.youtube.com/@DaneDaneTech" label="Otwórz kanał" variant="secondary" external />
		</div>
	</section>

	<section class="section">
		<div class="container cta-row">
			<div class="card cta-box">
				<h3>Chcesz porozmawiać o danych?</h3>
				<p>Jeśli potrzebujesz wsparcia w SQL, analityce, BI lub pipeline'ach danych — napisz.</p>
				<Button href="/kontakt" label="Skontaktuj się" />
			</div>
			<div class="card cta-box">
				<h3>Chcesz zobaczyć więcej treści?</h3>
				<p>Sprawdź wpisy na blogu i poznaj moje podejście do pracy z danymi.</p>
				<Button href="/blog" label="Czytaj bloga" variant="secondary" />
			</div>
		</div>
	</section>
</PageLayout>

<style>
	.hero {
		padding-top: 1rem;
	}
	.hero-content {
		max-width: var(--content-max);
	}
	.hero-heading {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
	}
	.hero-copy {
		padding: 3rem 0;
	}
	.split-intro {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 2rem;
		align-items: end;
	}
	.about-section-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.about-section-inner {
		position: relative;
		padding: 1.5rem;
		border: 1px solid transparent;
		border-radius: var(--radius-md);
		transition: border-color 0.2s ease, background 0.2s ease;
	}
	.about-section-cue {
		position: absolute;
		top: 1.5rem;
		right: 1.5rem;
		color: var(--color-primary);
		font-size: 0.8rem;
		font-weight: 700;
		opacity: 0;
		transform: translateX(-0.35rem);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}
	.about-section-cue span {
		display: inline-block;
		transition: transform 0.2s ease;
	}
	.about-section-link:hover .about-section-inner,
	.about-section-link:focus-visible .about-section-inner {
		border-color: var(--color-primary);
		background: rgba(255, 248, 242, 0.62);
	}
	.about-section-link:hover .about-section-cue,
	.about-section-link:focus-visible .about-section-cue {
		opacity: 1;
		transform: translateX(0);
	}
	.about-section-link:hover .about-section-cue span,
	.about-section-link:focus-visible .about-section-cue span {
		transform: translateX(0.2rem);
	}
	.about-section-link:hover .section-kicker,
	.about-section-link:focus-visible .section-kicker {
		color: var(--color-accent);
	}
	.about-section-link:hover h2,
	.about-section-link:focus-visible h2 {
		color: var(--color-primary);
	}
	.about-section-link:focus-visible {
		outline: none;
	}
	.section-heading {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
		align-items: end;
	}
	.specialization-heading {
		display: grid;
		grid-template-columns: 1fr 2fr;
		align-items: end;
	}
	.specialization-heading h2 {
		margin: 0;
		max-width: 620px;
	}
	.inline-heading {
		align-items: center;
	}
	.pill-grid,
	.card-grid {
		display: grid;
		gap: 1.5rem;
	}
	.pill-grid {
		grid-template-columns: repeat(5, minmax(0, 1fr));
	}
	.info-card {
		padding: 1.2rem;
		min-height: 245px;
		display: flex;
		flex-direction: column;
	}
	.specialization-icon {
		width: 2.2rem;
		height: 2.2rem;
		margin-bottom: 1.25rem;
		border-radius: 0;
	}
	.three-up {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}
	.project-card,
	.article-card {
		overflow: hidden;
	}
	.project-cover img,
	.article-cover img {
		width: 100%;
		height: 220px;
		object-fit: cover;
		border-radius: 0;
	}
	.article-card-body,
	.project-body {
		padding: 1.2rem;
	}
	.project-links {
		display: flex;
		gap: 0.8rem;
		margin-top: 1rem;
	}
	.project-links a {
		font-weight: 700;
		color: var(--color-primary);
	}
	.youtube-callout {
		display: grid;
		grid-template-columns: 1.1fr 1fr auto;
		gap: 1rem;
		padding: 2rem;
		align-items: center;
	}
	.cta-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}
	.cta-box {
		padding: 1.6rem;
	}
	@media (max-width: 900px) {
		.split-intro,
		.youtube-callout,
		.three-up,
		.cta-row {
			grid-template-columns: 1fr;
		}
		.pill-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.section-heading,
		.inline-heading {
			display: block;
		}
		.specialization-heading {
			display: block;
		}
		.hero-copy {
			padding: 2rem 0 1rem;
		}
	}
	@media (max-width: 520px) {
		.hero {
			padding-top: 0;
		}
		.hero-copy {
			padding-top: 1rem;
		}
		.hero-heading {
			align-items: flex-start;
			gap: 0.6rem;
		}
		.pill-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

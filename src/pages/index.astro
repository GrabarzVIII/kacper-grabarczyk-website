---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PageLayout from '../layouts/PageLayout.astro';
import { selectFeaturedProjects } from '../lib/projects';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);

const projects = selectFeaturedProjects(await getCollection('projects'));

const specializations = [
	{
		title: 'Business Intelligence',
		description: 'Dashboardy w Looker Studio, raportowanie zarządcze i analizy danych marketingowych.',
		icon: 'M4 4v16h16 M8 16v-5 M12 16V7 M16 16v-8',
	},
	{
		title: 'ETL / ELT i API',
		description: 'Pobieranie danych z API platform marketingowych oraz rozwój i utrzymanie procesów integracji.',
		icon: 'M4 7h15l-4-4 M20 17H5l4 4 M19 7l-4 4 M5 17l4-4',
	},
	{
		title: 'SQL i BigQuery',
		description: 'Budowa i optymalizacja przepływów danych w BigQuery, ekstrakty danych oraz walidacja i monitoring.',
		icon: 'M4 6c0-4 16-4 16 0s-16 4-16 0v12c0 4 16 4 16 0V6 M4 12c0 4 16 4 16 0',
	},
	{
		title: 'RAG i bazy wiedzy',
		description: 'Rozwój bazy wiedzy w wolontariacie Zosia AI oraz prywatne projekty agentów korzystających ze źródeł.',
		icon: 'M8 6l-6 6 6 6 M16 6l6 6-6 6 M14 3l-4 18',
	},
	{
		title: 'Automatyzacja i n8n',
		description: 'Przepływy operacyjne i analityczne, pozyskiwanie leadów oraz automatyczne dostarczanie ich do klientów.',
		icon: 'M3 3h6v6H3z M15 15h6v6h-6z M9 6h9v9 M6 9v9h9',
	},
];
---

<PageLayout title="Data Specialist | Kacper Grabarczyk" description="Profil zawodowy, portfolio i blog techniczny Kacpra Grabarczyka — BI, integracje danych, SQL, Python i automatyzacja.">
	<Hero />

	<section class="section section-tint">
		<a class="about-section-link" href="/about" aria-label="O mnie: poznaj moje doświadczenie i podejście do danych">
			<div class="container about-section-inner">
				<div class="split-intro">
					<div>
						<p class="section-kicker">Kim jestem</p>
						<h2>Dostarczam rozwiązania od surowych danych do decyzji biznesowych</h2>
					</div>
					<p>
						Łączę doświadczenie w Business Intelligence, integracji danych i automatyzacji
						z podejściem wyniesionym z inżynierii procesu produkcyjnego i jakości.
						Dzięki temu patrzę na dane w kontekście całego procesu biznesowego i potrzeb zespołu.
					</p>
				</div>
				<span class="about-section-cue" aria-hidden="true">Poznaj mnie <span>→</span></span>
			</div>
		</a>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-heading specialization-heading">
				<p class="section-kicker">Specjalizacja</p>
				<h2>Dane i automatyzacja</h2>
			</div>
			<div class="pill-grid">
				{specializations.map((specialization) => (
					<div class="card info-card">
						<svg class="specialization-icon" viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={specialization.icon} /></svg>
						<h3>{specialization.title}</h3>
						<p>{specialization.description}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	{projects.length > 0 && <section class="section section-tint">
		<div class="container">
			<div class="section-heading inline-heading">
				<div>
					<p class="section-kicker">Portfolio</p>
					<h2>Wybrane projekty</h2>
				</div>
				<Button href="/portfolio" label="Zobacz portfolio" variant="secondary" />
			</div>
			<div class="card-grid three-up">
				{projects.map((project) => <ProjectCard project={project} />)}
			</div>
		</div>
	</section>}

	<section class="section">
		<div class="container">
			<div class="section-heading inline-heading">
				<div>
					<p class="section-kicker">Blog</p>
					<h2>Najnowsze wpisy</h2>
				</div>
				<Button href="/blog" label="Przejdź do bloga" variant="secondary" />
			</div>
			<div class="card-grid three-up">
				{posts.map((post) => <ArticleCard post={post} />)}
			</div>
		</div>
	</section>

	<section class="section section-tint">
		<div class="container youtube-callout card">
			<div>
				<p class="section-kicker">DaneDaneTech</p>
				<h2>Technologia, dane i praktyka w jednym miejscu.</h2>
			</div>
			<p>
				Na kanale DaneDaneTech dzielę się materiałami o SQL, Pythonie, BI, modelowaniu danych i pracy
				z narzędziami analitycznymi. To miejsce dla osób, które chcą rozwijać swoje umiejętności w praktyce.
			</p>
			<Button href="https://www.youtube.com/@DaneDaneTech" label="Otwórz kanał" variant="secondary" external />
		</div>
	</section>

	<section class="section">
		<div class="container cta-row">
			<div class="card cta-box">
				<h2>Chcesz porozmawiać o danych?</h2>
				<p>Jeśli potrzebujesz wsparcia w SQL, analityce, BI lub pipeline'ach danych — napisz.</p>
				<Button href="/kontakt" label="Skontaktuj się" />
			</div>
			<div class="card cta-box">
				<h2>Chcesz zobaczyć więcej treści?</h2>
				<p>Sprawdź wpisy na blogu i poznaj moje podejście do pracy z danymi.</p>
				<Button href="/blog" label="Czytaj bloga" variant="secondary" />
			</div>
		</div>
	</section>
</PageLayout>

<style>
	.split-intro {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 2rem;
		align-items: end;
	}
	.about-section-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.about-section-inner {
		position: relative;
		padding: 1.5rem;
		border: 1px solid transparent;
		border-radius: var(--radius-md);
		transition: border-color 0.2s ease, background 0.2s ease;
	}
	.about-section-cue {
		display: inline-block;
		margin-top: 1rem;
		color: var(--color-primary);
		font-size: 0.8rem;
		font-weight: 700;
		opacity: 1;
		transform: translateX(0);
		transition: opacity 0.2s ease, transform 0.2s ease;
	}
	.about-section-cue span {
		display: inline-block;
		transition: transform 0.2s ease;
	}
	.about-section-link:hover .about-section-inner,
	.about-section-link:focus-visible .about-section-inner {
		border-color: var(--color-primary);
		background: rgba(255, 248, 242, 0.62);
	}
	.about-section-link:hover .about-section-cue,
	.about-section-link:focus-visible .about-section-cue {
		opacity: 1;
		transform: translateX(0);
	}
	.about-section-link:hover .about-section-cue span,
	.about-section-link:focus-visible .about-section-cue span {
		transform: translateX(0.2rem);
	}
	.about-section-link:hover .section-kicker,
	.about-section-link:focus-visible .section-kicker {
		color: var(--color-primary);
	}
	.about-section-link:hover h2,
	.about-section-link:focus-visible h2 {
		color: var(--color-primary);
	}
	.about-section-link:focus-visible {
		outline: none;
	}
	.section-heading {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
		align-items: end;
	}
	.specialization-heading {
		display: block;
	}
	.specialization-heading h2 {
		margin: 0;
		max-width: 620px;
	}
	.inline-heading {
		align-items: center;
	}
	.pill-grid,
	.card-grid {
		display: grid;
		gap: 1.5rem;
	}
	.pill-grid {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
	}
	.info-card {
		padding: 1.2rem;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}
	.specialization-icon {
		color: var(--color-primary);
		width: 2.2rem;
		height: 2.2rem;
		margin-bottom: 1.25rem;
		border-radius: 0;
	}
	.three-up {
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
	}
	.youtube-callout {
		display: grid;
		grid-template-columns: 1.1fr 1fr auto;
		gap: 1rem;
		padding: 2rem;
		align-items: center;
	}
	.cta-row {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
	}
	.cta-box h2 {
		font-size: 1.5rem;
	}
	.info-card p {
		font-size: 0.95rem;
		color: var(--color-muted);
		margin-bottom: 0;
	}
	.cta-box {
		padding: 1.6rem;
	}
	@media (max-width: 900px) {
		.split-intro,
		.youtube-callout,
		.cta-row {
			grid-template-columns: 1fr;
		}
		.pill-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.section-heading,
		.inline-heading {
			display: block;
		}
		.specialization-heading {
			display: block;
		}
	}
	@media (max-width: 520px) {
		.pill-grid {
			grid-template-columns: 1fr;
		}
		.info-card {
			display: grid;
			grid-template-columns: 2rem minmax(0, 1fr);
			column-gap: 1rem;
			padding: 1rem;
		}
		.info-card h3 {
			margin-bottom: 0.5rem;
		}
		.info-card p {
			grid-column: 2;
		}
		.specialization-icon {
			width: 2rem;
			height: 2rem;
			margin: 0;
		}
	}
</style>

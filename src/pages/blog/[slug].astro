---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Tag from '../../components/Tag.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts
		.filter((post) => !post.data.draft)
		.map((post) => ({
			params: { slug: post.id },
			props: { post },
		}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const formattedDate = post.data.date;
const updatedDate = post.data.updatedDate ?? null;
---

<PageLayout title={post.data.title} description={post.data.description} pageName="Blog">
	<article class="article-page">
		<header class="article-header container">
			<p class="section-kicker">Artykuł</p>
			<h1>{post.data.title}</h1>
			<p class="lead">{post.data.description}</p>
			<div class="article-meta">
				<FormattedDate date={formattedDate} />
				{updatedDate && <span>· zaktualizowano <FormattedDate date={updatedDate} /></span>}
			</div>
			<ul class="tag-list">
				{post.data.tags.map((tag) => <Tag label={tag} />)}
			</ul>
			{post.data.cover && (
				<div class="article-cover-wrap">
					<Image src={post.data.cover} alt={post.data.title} width={1600} height={900} />
				</div>
			)}
		</header>

		<div class="article-layout container">
			<aside class="toc card" aria-label="Spis treści">
				<h2>Spis treści</h2>
				<ul>
					{headings
						.filter((heading) => heading.depth > 1 && heading.depth < 4)
						.map((heading) => (
						<li class={`depth-${heading.depth}`}>
							<a href={`#${heading.slug}`}>{heading.text}</a>
						</li>
					))}
				</ul>
			</aside>
			<div class="article-content prose">
				<Content />
			</div>
		</div>
	</article>
</PageLayout>

<style>
	.article-page {
		padding-top: 2rem;
	}
	.article-header {
		margin-bottom: 2rem;
	}
	.article-header h1 {
		max-width: 820px;
	}
	.lead {
		font-size: clamp(1.08rem, 1.8vw, 1.45rem);
		color: var(--color-muted);
		max-width: 760px;
	}
	.article-meta {
		margin: 1rem 0;
		color: var(--color-muted);
	}
	.article-cover-wrap {
		margin-top: 1.5rem;
	}
	.article-layout {
		display: grid;
		grid-template-columns: 260px minmax(0, 1fr);
		gap: 2rem;
		align-items: start;
	}
	.toc {
		padding: 1.2rem;
		position: sticky;
		top: 90px;
	}
	.toc h2 {
		font-size: 1rem;
		margin-bottom: 0.8rem;
	}
	.toc ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.45rem;
	}
	.toc a {
		color: var(--color-muted);
	}
	.depth-3 {
		margin-left: 0.9rem;
	}
	.prose {
		max-width: 760px;
		line-height: 1.75;
	}
	.prose h2,
	.prose h3 {
		margin-top: 2.5rem;
	}
	.prose ul,
	.prose ol {
		padding-left: 1.3rem;
	}
	.prose a {
		color: var(--color-primary);
		text-decoration: underline;
		text-underline-offset: 0.14em;
	}
	.prose img {
		margin: 2rem 0;
	}
	@media (max-width: 980px) {
		.article-layout {
			display: block;
		}
		.toc {
			position: static;
			margin-bottom: 1.5rem;
		}
	}
</style>

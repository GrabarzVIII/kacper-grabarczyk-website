---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import BlogCategories from '../../components/BlogCategories.astro';

const posts = (await getCollection('blog')).filter((post) => !post.data.draft).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title="Blog | Kacper Grabarczyk" description="Blog techniczny o SQL, Pythonie, danych, BI i inżynierii danych." pageName="Blog">
	<section class="section">
		<div class="container">
			<div class="section-heading">
				<div>
					<p class="section-kicker">Blog</p>
					<h1>Artykuły o danych i technologii</h1>
				</div>
			</div>
			<BlogCategories />
			{posts.length === 0 && <p class="intro-copy">Pierwsze artykuły pojawią się tutaj wkrótce.</p>}
			<div class="card-grid three-up">
				{posts.map((post) => <ArticleCard post={post} headingLevel="h2" />)}
			</div>
		</div>
	</section>
</PageLayout>

<style>
.intro-copy {
	max-width: 720px;
	margin-bottom: 2rem;
	color: var(--color-muted);
}
.card-grid {
	display: grid;
	gap: 1.5rem;
	grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
}
.section-heading {
	margin-bottom: 2rem;
}
</style>

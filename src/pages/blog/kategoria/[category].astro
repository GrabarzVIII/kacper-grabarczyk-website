---
import { getCollection } from 'astro:content';
import { BLOG_CATEGORIES, type BlogCategory } from '../../../data/blog';
import PageLayout from '../../../layouts/PageLayout.astro';
import BlogCategories from '../../../components/BlogCategories.astro';
import ArticleCard from '../../../components/ArticleCard.astro';

export function getStaticPaths() {
	return (Object.keys(BLOG_CATEGORIES) as BlogCategory[]).map((category) => ({
		params: { category }, props: { category },
	}));
}

const { category } = Astro.props;
const section = BLOG_CATEGORIES[category];
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.category === category))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<PageLayout title={`${section.label} | Blog DaneDaneTech`} description={section.description}>
	<section class="section container">
		<p class="section-kicker">Blog</p>
		<h1>{section.label}</h1>
		<p class="muted">{section.description}</p>
		<BlogCategories active={category} />
		{posts.length > 0 ? <div class="card-grid">
			{posts.map((post) => <ArticleCard post={post} headingLevel="h2" />)}
		</div> : <div class="card empty-state">
			<h2>Pierwsze wpisy jeszcze przed nami</h2>
			<p>W sekcji „{section.label}” nie ma jeszcze opublikowanych artykułów.</p>
			<a class="text-link" href="/blog">Zobacz wszystkie wpisy →</a>
		</div>}
	</section>
</PageLayout>

<style>
	.card-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr)); }
	.empty-state { padding: clamp(1.25rem, 4vw, 2rem); }
	.empty-state h2 { font-size: 1.5rem; }
	.empty-state a { display: inline-flex; align-items: center; min-height: 44px; }
</style>

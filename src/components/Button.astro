---
interface Props {
	href: string;
	label: string;
	variant?: 'primary' | 'secondary';
	external?: boolean;
}

const { href, label, variant = 'primary', external = false } = Astro.props;
const externalProps = external ? { target: '_blank', rel: 'noreferrer' } : {};
---

<a class={`button ${variant}`} href={href} {...externalProps}>
	{label}
	<span aria-hidden="true">→</span>
</a>

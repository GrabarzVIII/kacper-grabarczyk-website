---
import Button from './Button.astro';
---

<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<h1>Data Specialist</h1>
			<p class="hero-name">Kacper Grabarczyk</p>
			<div class="hero-actions">
				<Button href="/portfolio" label="Zobacz portfolio" />
				<Button href="/kontakt" label="Kontakt" variant="secondary" />
			</div>
		</div>
		<div class="hero-logo card">
			<img src="/logo-mono.png" alt="Logo DaneDaneTech" />
		</div>
	</div>
</section>

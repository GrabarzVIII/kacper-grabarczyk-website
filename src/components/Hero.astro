---

<section class="hero">
	<div class="container hero-content">
		<div class="hero-heading">
			<div class="hero-copy">
				<h1>
					<a class="hero-title-link" href="/about" aria-label="O mnie: Data Specialist">
						<img class="hero-logo" src="/logo-mono.png" alt="" />
						<span>Data Specialist</span>
						<span class="click-cue" aria-hidden="true">→</span>
					</a>
				</h1>
				<p class="hero-name">Kacper Grabarczyk</p>
			</div>
		</div>
	</div>
</section>

<style>
	.hero-title-link {
		display: inline-flex;
		align-items: center;
		gap: 0.18em;
		color: inherit;
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.hero-title-link:hover,
	.hero-title-link:focus-visible {
		color: var(--color-primary);
	}
	.hero-title-link:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}
	.click-cue {
		display: inline-block;
		width: auto;
		height: auto;
		flex: 0 0 auto;
		line-height: 1;
		font-size: 0.55em;
		color: var(--color-primary);
		transform: translateX(0);
		transition: transform 0.2s ease;
	}
	.hero-title-link:hover .click-cue,
	.hero-title-link:focus-visible .click-cue {
		transform: translateX(0.16em);
	}
	.hero-logo {
		width: 1em;
		height: 1em;
		flex: 0 0 1em;
		object-fit: contain;
		border-radius: 0;
	}
</style>

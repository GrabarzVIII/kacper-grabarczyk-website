<section class="hero">
	<div class="container hero-content">
		<div class="hero-heading">
			<a class="hero-title-link" href="/about" aria-label="O mnie: Data Specialist, Kacper Grabarczyk">
				<h1>
					<img class="hero-logo" src="/logo-mono.png" alt="" />
					<span>Data Specialist</span>
				</h1>
				<p class="hero-name">Kacper Grabarczyk</p>
			</a>
		</div>
	</div>
</section>

<style>
	.hero-title-link {
		display: block;
		width: fit-content;
		padding: 0.35rem 0.5rem 0.5rem;
		margin: -0.35rem 0 0 -0.5rem;
		color: inherit;
		text-decoration: none;
		border: 1px solid transparent;
		border-radius: var(--radius-sm);
		transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
	}
	.hero-title-link:hover,
	.hero-title-link:focus-visible {
		color: var(--color-primary);
		border-color: var(--color-primary);
		background: rgba(91, 34, 23, 0.035);
	}
	.hero-title-link:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.12em;
	}
	.hero-title-link h1 {
		display: flex;
		align-items: center;
		gap: 0.18em;
		margin-bottom: 0.08em;
	}
	.hero-name {
		margin: 0;
		font-size: clamp(1.25rem, 2vw, 1.8rem);
		font-weight: 600;
		color: var(--color-muted);
	}
	.hero-logo {
		width: 1em;
		height: 1em;
		flex: 0 0 1em;
		object-fit: contain;
		border-radius: 0;
	}
</style>

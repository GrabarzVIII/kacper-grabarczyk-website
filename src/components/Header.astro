---
import { NAV_ITEMS, SITE_TITLE, SOCIAL_LINKS } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="site-header">
	<div class="container nav-wrap">
		<a class="brand" href="/" aria-label={SITE_TITLE}>
			<img class="brand-mark" src="/logo.svg" alt="" />
		</a>
		<nav aria-label="Główna nawigacja" class="main-nav">
			{NAV_ITEMS.map((item) => <HeaderLink href={item.href}>{item.label}</HeaderLink>)}
		</nav>
		<div class="nav-actions">
			<a class="nav-youtube" href={SOCIAL_LINKS.youtube} target="_blank" rel="noreferrer">YouTube</a>
		</div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(244, 238, 232, 0.88);
		backdrop-filter: blur(18px);
		border-bottom: 1px solid rgba(91, 34, 23, 0.08);
	}
	.nav-wrap {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 74px;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		font-weight: 800;
		color: var(--color-text);
		letter-spacing: -0.03em;
	}
	.brand-mark {
		display: block;
		width: 2.7rem;
		height: 2.7rem;
		border-radius: 0;
		object-fit: contain;
	}
	.main-nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
	}
	.main-nav a {
		padding: 0.5rem 0.8rem;
		border-radius: 999px;
		font-weight: 600;
		color: var(--color-muted);
	}
	.main-nav a.active,
	.main-nav a:hover,
	.main-nav a:focus-visible {
		background: rgba(91, 34, 23, 0.06);
		color: var(--color-text);
	}
	.nav-youtube {
		padding: 0.65rem 0.9rem;
		border-radius: 999px;
		background: var(--color-primary);
		color: white;
		font-weight: 700;
	}
	@media (max-width: 900px) {
		.nav-wrap {
			padding: 0.75rem 0;
			flex-wrap: wrap;
		}
		.main-nav {
			justify-content: flex-start;
			overflow-x: auto;
			width: 100%;
			padding-bottom: 0.4rem;
		}
	}
	@media (max-width: 520px) {
		.nav-actions {
			display: none;
		}
		.brand {
			font-size: 0.95rem;
		}
	}
</style>
